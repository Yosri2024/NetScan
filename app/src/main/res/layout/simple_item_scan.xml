<?xml version="1.0" encoding="utf-8"?>
<!-- Fichier : res/layout/simple_item_scan.xml -->
<!-- Rôle : ligne d'historique Simple (Étape 4). Point + date + résumé. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/screen_padding_small"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:padding="@dimen/screen_padding">

        <View
            android:id="@+id/dot_status"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_status_dot"
            android:contentDescription="@string/simple_status_dot_description" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_scan_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.NetScan.TitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/text_scan_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.NetScan.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>