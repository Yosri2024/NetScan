<?xml version="1.0" encoding="utf-8"?>
<!-- Fichier : res/layout/expert_item_scan.xml -->
<!-- Rôle : ligne d'historique Expert (Étape 4). Stats + exports. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/Widget.NetScan.Card"
    android:layout_marginBottom="@dimen/screen_padding_small">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:id="@+id/text_scan_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/screen_padding_xs"
            android:fontFamily="monospace"
            android:textAppearance="@style/TextAppearance.NetScan.TitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/text_scan_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/screen_padding"
            android:fontFamily="monospace"
            android:textAppearance="@style/TextAppearance.NetScan.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_export_json"
                style="@style/Widget.NetScan.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/screen_padding_small"
                android:text="@string/expert_export_json"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_export_csv"
                style="@style/Widget.NetScan.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/expert_export_csv"
                />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>