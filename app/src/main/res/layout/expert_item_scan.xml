<?xml version="1.0" encoding="utf-8"?>
<!-- Fichier : res/layout/expert_item_scan.xml -->
<!-- Rôle : ligne d'historique Expert (Étape 4). Stats + exports. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/screen_padding_small"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:id="@+id/text_scan_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/screen_padding_xs"
            android:fontFamily="monospace"
            android:textAppearance="@style/TextAppearance.NetScan.TitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/text_scan_stats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/screen_padding"
            android:fontFamily="monospace"
            android:textAppearance="@style/TextAppearance.NetScan.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_export_json"
                style="@style/Widget.NetScan.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_target_min"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/screen_padding_small"
                android:text="@string/expert_export_json"
                android:textAllCaps="false"
                android:elevation="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_export_csv"
                style="@style/Widget.NetScan.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_target_min"
                android:layout_weight="1"
                android:text="@string/expert_export_csv"
                android:textAllCaps="false"
                android:elevation="2dp" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>