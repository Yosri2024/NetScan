<?xml version="1.0" encoding="utf-8"?>
<!-- Fichier : res/layout/expert_activity_scan.xml -->
<!-- Rôle : écran de scan Expert (refonte). Trois cartes (Réseau,
     Configuration, Progression), la liste des appareils, puis une barre
     d'action FIXE en bas : « Démarrer » OU « Arrêter », jamais les deux.
     Plus de boutons morts (Annuler caché), de doublons Historique/Réglages
     (déjà dans la barre du bas) ni de liste de ports en Spinner. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- En-tête : titre + pastille de mode -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/screen_padding_small"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/screen_padding_small">

        <TextView
            android:id="@+id/text_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/expert_title"
            android:textAppearance="@style/TextAppearance.NetScan.TitleLarge"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/pastille_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding_small"
            android:background="@drawable/bg_mode_chip"
            android:contentDescription="@string/mode_switch_description"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/mode_expert_badge"
            android:textAppearance="@style/TextAppearance.NetScan.LabelMedium"
            android:textColor="?attr/colorOnPrimaryContainer" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- Carte Réseau -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.NetScan.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/screen_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/expert_section_network"
                        android:textAppearance="@style/TextAppearance.NetScan.TitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/text_wifi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/screen_padding_xs"
                        android:fontFamily="monospace"
                        android:text="@string/expert_network_disconnected"
                        android:textAppearance="@style/TextAppearance.NetScan.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Carte Configuration -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.NetScan.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/screen_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/expert_section_config"
                        android:textAppearance="@style/TextAppearance.NetScan.TitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <!-- Plage CIDR + icône « Détecter » intégrée au champ -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_cidr"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/screen_padding_small"
                        android:hint="@string/expert_cidr_label"
                        app:endIconContentDescription="@string/expert_detect_description"
                        app:endIconDrawable="@drawable/ic_detect"
                        app:endIconMode="custom">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_cidr"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Ports -->
                    <TextView
                        android:id="@+id/expert_ports_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/expert_ports_label"
                        android:textAppearance="@style/TextAppearance.NetScan.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_ports"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/screen_padding_xs"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_ports_common"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/expert_preset_common" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_ports_all"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/expert_preset_all" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_ports_custom"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/expert_preset_custom" />
                    </com.google.android.material.chip.ChipGroup>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layout_custom_ports"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/screen_padding_small"
                        android:hint="@string/expert_custom_ports_label"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/edit_custom_ports"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="@string/expert_custom_hint_description"
                            android:fontFamily="monospace"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Timeout + threads côte à côte -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/screen_padding_small"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layout_timeout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/screen_padding_small"
                            android:layout_weight="1"
                            android:hint="@string/expert_timeout_label"
                            app:suffixText="ms">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edit_timeout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/expert_timeout_description"
                                android:imeOptions="actionNext"
                                android:importantForAutofill="no"
                                android:inputType="number"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layout_threads"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/screen_padding_small"
                            android:layout_weight="1"
                            android:hint="@string/expert_threads_label">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/edit_threads"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/expert_threads_description"
                                android:imeOptions="actionDone"
                                android:importantForAutofill="no"
                                android:inputType="number"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- Identification de l'OS -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_os"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/screen_padding_small"
                        android:checked="true"
                        android:minHeight="@dimen/touch_target_min"
                        android:text="@string/expert_os_label"
                        android:textAppearance="@style/TextAppearance.NetScan.BodyLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/expert_os_helper"
                        android:textAppearance="@style/TextAppearance.NetScan.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Progression : visible pendant le scan -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_progress"
                style="@style/Widget.NetScan.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_padding"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/screen_padding">

                    <TextView
                        android:id="@+id/text_phase"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/expert_status_scanning"
                        android:textAppearance="@style/TextAppearance.NetScan.TitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/screen_padding_small"
                        android:indeterminate="true"
                        app:trackCornerRadius="4dp" />

                    <TextView
                        android:id="@+id/text_progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/screen_padding_xs"
                        android:fontFamily="monospace"
                        android:textAppearance="@style/TextAppearance.NetScan.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Message d'état (erreur, permission refusée) + accès aux réglages système -->
            <TextView
                android:id="@+id/text_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_padding"
                android:textAppearance="@style/TextAppearance.NetScan.BodyMedium"
                android:textColor="?attr/colorOnSurface"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_settings"
                style="@style/Widget.NetScan.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_padding_small"
                android:text="@string/expert_open_settings"
                android:visibility="gone" />

            <!-- Résultats -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_padding"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/text_results_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/expert_section_results"
                    android:textAppearance="@style/TextAppearance.NetScan.TitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/text_results_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.NetScan.LabelMedium"
                    android:textColor="?attr/colorPrimary" />
            </LinearLayout>

            <TextView
                android:id="@+id/text_results_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_padding_small"
                android:padding="@dimen/screen_padding"
                android:gravity="center"
                android:text="@string/expert_results_empty"
                android:textAppearance="@style/TextAppearance.NetScan.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_hosts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_padding_small"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Barre d'action fixe : un seul bouton visible à la fois -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/screen_padding_small"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/screen_padding_small">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_start"
            style="@style/Widget.NetScan.Button.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/expert_start_scan"
            app:icon="@drawable/ic_detect" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_cancel"
            style="@style/Widget.NetScan.Button.Destructive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/button_height_main"
            android:text="@string/expert_stop_scan"
            android:visibility="gone"
            app:icon="@drawable/ic_stop" />
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/simple_bottom_nav" />
</LinearLayout>
