<?xml version="1.0" encoding="utf-8"?>
<!-- Fichier : res/layout/expert_item_host.xml -->
<!-- Rôle : ligne dense d'hôte (Étape 2). Valeurs en monospace. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/screen_padding_small"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:id="@+id/text_ip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/screen_padding_xs"
            android:fontFamily="monospace"
            android:textAppearance="@style/TextAppearance.NetScan.TitleMedium"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/text_hostname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/screen_padding_xs"
            android:fontFamily="monospace"
            android:textAppearance="@style/TextAppearance.NetScan.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/text_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/screen_padding_xs"
            android:fontFamily="monospace"
            android:textAppearance="@style/TextAppearance.NetScan.BodySmall"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:id="@+id/text_banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textAppearance="@style/TextAppearance.NetScan.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>