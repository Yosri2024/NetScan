<?xml version="1.0" encoding="utf-8"?>
<!-- Fichier : res/layout/simple_dialog_device.xml -->
<!-- Rôle : fiche d'un appareil Simple (refonte). Identité + système estimé
     (avec confiance et indices) puis actions. Les conseils restent MASQUÉS
     tant qu'on n'a pas touché « Je ne reconnais pas » (avant : un cadre gris
     vide était visible en permanence). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding_large">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/icon_container"
                android:layout_width="@dimen/device_icon_container"
                android:layout_height="@dimen/device_icon_container">

                <ImageView
                    android:id="@+id/image_os"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_os_unknown" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_device_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.NetScan.TitleLarge"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/text_device_ip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textAppearance="@style/TextAppearance.NetScan.BodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/chip_os"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/screen_padding"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />

        <TextView
            android:id="@+id/text_device_os"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/screen_padding_small"
            android:textAppearance="@style/TextAppearance.NetScan.BodyMedium"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/text_os_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/screen_padding_small"
            android:text="@string/os_hint"
            android:textAppearance="@style/TextAppearance.NetScan.BodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_mine"
            style="@style/Widget.NetScan.Button.Filled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/screen_padding_large"
            android:text="@string/simple_device_mine" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_unknown"
            style="@style/Widget.NetScan.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/screen_padding_small"
            android:text="@string/simple_device_unknown" />

        <TextView
            android:id="@+id/text_advice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/screen_padding"
            android:padding="@dimen/screen_padding"
            android:background="?attr/colorSurfaceVariant"
            android:textAppearance="@style/TextAppearance.NetScan.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_close"
            style="@style/Widget.NetScan.Button.Borderless"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/screen_padding_small"
            android:text="@string/simple_device_close" />
    </LinearLayout>
</ScrollView>
