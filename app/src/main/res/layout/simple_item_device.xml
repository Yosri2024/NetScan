<?xml version="1.0" encoding="utf-8"?>
<!-- Fichier : res/layout/simple_item_device.xml -->
<!-- Rôle : ligne d'appareil Simple (Étape 3). Point couleur + nom + sous-texte. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/screen_padding_small"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/screen_padding"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:minHeight="64dp">

        <!-- Point statut : vert/Orange, accompagnant le texte. -->
        <View
            android:id="@+id/dot_status"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/bg_status_dot"
            android:layout_marginEnd="@dimen/screen_padding" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.NetScan.BodyLarge"
                android:textColor="?attr/colorOnSurface"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/text_device_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_padding_xs"
                android:textAppearance="@style/TextAppearance.NetScan.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>