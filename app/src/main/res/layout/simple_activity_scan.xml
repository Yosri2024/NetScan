<?xml version="1.0" encoding="utf-8"?>
<!-- Fichier : res/layout/simple_activity_scan.xml -->
<!-- Rôle : écran d'accueil du mode Simple (refonte). Entièrement défilant :
     rien n'est rogné en paysage ni avec de grandes polices. Un seul bouton
     principal ; pendant le scan il laisse la place à une carte de progression
     avec le bouton Annuler (plus de boutons qui se chevauchent). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- En-tête : titre + pastille de mode -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/screen_padding_small"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/screen_padding_small">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.NetScan.TitleLarge"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/text_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/simple_toolbar_subtitle"
                android:textAppearance="@style/TextAppearance.NetScan.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <TextView
            android:id="@+id/pastille_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding_small"
            android:background="@drawable/bg_mode_chip"
            android:contentDescription="@string/mode_switch_description"
            android:gravity="center"
            android:minHeight="@dimen/touch_target_min"
            android:text="@string/mode_simple_badge"
            android:textAppearance="@style/TextAppearance.NetScan.LabelMedium"
            android:textColor="?attr/colorOnPrimaryContainer" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- Carte réseau -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_hero"
                style="@style/Widget.NetScan.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorPrimaryContainer"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/screen_padding_large">

                    <ImageView
                        android:id="@+id/image_wifi"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:contentDescription="@string/simple_network_icon_description"
                        android:src="@drawable/ic_wifi" />

                    <TextView
                        android:id="@+id/text_ssid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/screen_padding_small"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="2"
                        android:text="@string/simple_network_unknown"
                        android:textAppearance="@style/TextAppearance.NetScan.Headline3"
                        android:textColor="?attr/colorOnPrimaryContainer" />

                    <TextView
                        android:id="@+id/text_wifi_state"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/screen_padding_xs"
                        android:gravity="center"
                        android:text="@string/simple_network_disconnected"
                        android:textAppearance="@style/TextAppearance.NetScan.BodyLarge"
                        android:textColor="?attr/colorOnPrimaryContainer" />

                    <TextView
                        android:id="@+id/text_scan_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/screen_padding"
                        android:gravity="center"
                        android:text="@string/simple_scan_hint"
                        android:textAppearance="@style/TextAppearance.NetScan.BodyMedium"
                        android:textColor="?attr/colorOnPrimaryContainer" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action : bouton de scan -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_scan"
                style="@style/Widget.NetScan.Button.Large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_padding"
                android:contentDescription="@string/simple_scan_button_description"
                android:text="@string/simple_scan_button"
                app:icon="@drawable/ic_detect" />

            <!-- Progression : visible seulement pendant le scan -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_progress"
                style="@style/Widget.NetScan.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_padding"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/screen_padding">

                    <TextView
                        android:id="@+id/text_scanning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/simple_scanning_description"
                        android:text="@string/simple_scanning"
                        android:textAppearance="@style/TextAppearance.NetScan.TitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/text_progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/screen_padding_xs"
                        android:textAppearance="@style/TextAppearance.NetScan.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/scan_progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/screen_padding_small"
                        android:indeterminate="true"
                        app:trackCornerRadius="4dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_cancel"
                        style="@style/Widget.NetScan.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/screen_padding"
                        android:contentDescription="@string/simple_cancel_description"
                        android:text="@string/simple_cancel"
                        app:icon="@drawable/ic_stop" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Dernier scan -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_last_scan"
                style="@style/Widget.NetScan.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/screen_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/screen_padding">

                    <TextView
                        android:id="@+id/text_last_scan_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/simple_last_scan_title_description"
                        android:text="@string/simple_last_scan_title"
                        android:textAppearance="@style/TextAppearance.NetScan.TitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:id="@+id/text_last_scan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/screen_padding_xs"
                        android:text="@string/simple_no_last_scan"
                        android:textAppearance="@style/TextAppearance.NetScan.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/button_last_results"
                        style="@style/Widget.NetScan.Button.Borderless"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/screen_padding_small"
                        android:text="@string/simple_view_results"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/simple_bottom_nav" />
</LinearLayout>
