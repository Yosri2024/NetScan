<?xml version="1.0" encoding="utf-8"?>
<!-- Fichier : res/layout/simple_activity_results.xml -->
<!-- Rôle : Écran 2 du mode Simple (Étape 3). Barre de retour, bandeau
     résumé, liste des appareils, encart Conseils. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:background="?attr/colorBackground">

    <!-- Barre du haut : retour seul (pas de pastille sur les résultats). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="?attr/colorSurface">

        <ImageButton
            android:id="@+id/button_back"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:layout_marginStart="@dimen/screen_padding_small"
            android:layout_marginTop="@dimen/screen_padding_small"
            android:layout_marginBottom="@dimen/screen_padding_small"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/common_back_description"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_weight="1"
            android:text="@string/simple_results_title"
            android:textAppearance="@style/TextAppearance.NetScan.Headline5"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/text_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/screen_padding"
            android:text="@string/simple_results_empty"
            android:textAppearance="@style/TextAppearance.NetScan.LabelMedium"
            android:textColor="?attr/colorPrimary" />
    </LinearLayout>

    <!-- Bandeau résumé : fond vert ou orange selon la situation. -->
    <FrameLayout
        android:id="@+id/banner_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/screen_padding_large"
        android:background="?attr/colorPrimaryContainer">

        <TextView
            android:id="@+id/text_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.NetScan.BodyLarge"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Liste des appareils détectés -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_devices"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="@dimen/screen_padding" />

    <!-- État vide pro simple -->
    <TextView
        android:id="@+id/text_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/screen_padding_large"
        android:gravity="center"
        android:text="@string/simple_results_empty"
        android:textAppearance="@style/TextAppearance.NetScan.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <!-- Encart Conseils : texte nuancé, jamais alarmiste. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_advice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/screen_padding"
        android:layout_marginTop="@dimen/screen_padding_small"
        android:layout_marginBottom="@dimen/screen_padding"
        app:cardBackgroundColor="?attr/colorSurfaceVariant"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/screen_padding_large"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="@dimen/screen_padding_small"
                android:src="@drawable/ic_device_warning"
                app:tint="?attr/colorWarning" />

            <TextView
                android:id="@+id/text_advice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.NetScan.BodyMedium"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>