<?xml version="1.0" encoding="utf-8"?>
<!-- Fichier : res/drawable/bg_mode_chip.xml -->
<!-- Rôle : fond de la pastille de mode (Simple/Expert). Le visuel fait ~28dp
     de haut mais la zone tactile atteint 48dp : l'inset vertical ajoute de
     la marge TACTILE autour de la pastille (avant : 32dp, trop petit). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="8dp"
    android:insetBottom="8dp">
    <shape android:shape="rectangle">
        <solid android:color="?attr/colorPrimaryContainer" />
        <corners android:radius="24dp" />
        <padding
            android:left="12dp"
            android:top="4dp"
            android:right="12dp"
            android:bottom="4dp" />
    </shape>
</inset>
